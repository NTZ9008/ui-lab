        {
          "id": "c2000002-0000-0000-0000-000000000004",
          "comment": "",
          "command": "click",
          "target": "xpath=//label[.//span[normalize-space()='Advanced']]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c2000002-0000-0000-0000-000000000005",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "xpath=//label[normalize-space()='Max Calories per Slice']/../input",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c2000002-0000-0000-0000-000000000006",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=select",
