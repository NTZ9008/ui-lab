          "target": "xpath=//label[normalize-space()='Max Calories per Slice']/../input",
          "targets": [],
          "value": "600"
        },
        {
          "id": "c2000002-0000-0000-0000-000000000017",
          "comment": "",
          "command": "assertSelectedLabel",
          "target": "css=select",
          "targets": [],
          "value": "Knife"
        },
        {
          "id": "c2000002-0000-0000-0000-000000000018",
          "comment": "",
